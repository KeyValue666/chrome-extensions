{
  "name": "xtab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XTab — 离线可用的新标签页：时钟、聚合搜索、快捷方式、壁纸、待办与便签",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:ui": "vite --port 5174 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
